{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Secret": "dev-only-super-secret-key-change-me-before-shipping-32bytes+"
  },
  "ContentSeed": {
    "Enabled": true,
    "RunOnStartup": true,
    "Platform": true,
    "Curriculum": true,
    "DemoPlayers": true,
    "DemoEvents": true
  },
  "Leaderboards": {
    "Enabled": true
  },
  "Curriculum": {
    // Every read compared in development, so a difference shows up on the first request that hits it.
    "ReadModel": "Shadow",
    "ShadowSampleRate": 1.0
  },
  "Studio": {
    // The Studio's Vite dev server (Share7.Studio: npm run dev).
    "PublicUrl": "http://localhost:5174"
  }
}
