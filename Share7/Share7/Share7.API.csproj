<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Share7.Application\Share7.Application.csproj" />
    <ProjectReference Include="..\Share7.Infrastructure\Share7.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-only settings (contains a placeholder JWT secret) must never leave this machine. -->
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Build the React console (Share7.Web) as part of publish.

    Hooked to publish rather than left as a manual `npm run build` on purpose: publishing to this
    project's host never deletes and never overwrites what it is not told about, so a forgotten
    front-end build does not fail loudly — it silently leaves the previous SPA live and looks like
    a deploy that did not take. Making MSBuild own the step removes the chance to forget.

    BeforeTargets="ComputeFilesToPublish" so the assets exist before the publish file list is
    assembled. The generated files are collected from wwwroot/app by the normal wwwroot glob.
  -->
  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)/../Share7.Web</SpaRoot>
  </PropertyGroup>

  <Target Name="BuildSpa" BeforeTargets="ComputeFilesToPublish" Condition="Exists('$(SpaRoot)/package.json')">
    <Message Importance="high" Text="Building React console from $(SpaRoot)…" />
    <!-- `npm ci` rather than `npm install`: it installs exactly what package-lock.json pins, so a
         publish cannot quietly pick up a different dependency version than the one tested. -->
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" Condition="!Exists('$(SpaRoot)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!--
    Build the Content Studio (Share7.Studio) as part of publish too, and publish it. StudioHosting
    serves it at /studio from wwwroot-studio.

    Two traps this avoids, both of which shipped a site where /studio answered with the Admin
    Console's sign-in (26 Sep 2026). The Studio was never built on publish, so it depended on
    somebody remembering `npm run build`. And it was never published at all: the old item,
    `wwwroot-studio**`, is not a recursive glob, and a static item is read before any target runs,
    so files a build makes during publish (Vite names them by hash) could never be in it anyway.
    The files are added here, after the build, the way the ASP.NET SPA templates do it.
  -->
  <PropertyGroup>
    <StudioRoot>$(MSBuildProjectDirectory)/../Share7.Studio</StudioRoot>
  </PropertyGroup>

  <Target Name="BuildStudio" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(StudioRoot)/package.json')">
    <Message Importance="high" Text="Building the Content Studio from $(StudioRoot)…" />
    <Exec Command="npm ci" WorkingDirectory="$(StudioRoot)" Condition="!Exists('$(StudioRoot)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(StudioRoot)" />

    <ItemGroup>
      <StudioDist Include="wwwroot-studio\**" />
      <ResolvedFileToPublish Include="@(StudioDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot-studio\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
