{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.\\SQLEXPRESS;Initial Catalog=Shareh;Integrated Security=SSPI;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "Share7.Api",
    "Audience": "Share7.Client",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Leaderboards": {
    // OFF until the first board is authored. Unlike a rate limit, an unfinished leaderboard
    // protects nothing by being on, and half-populated boards in production are worse than absent
    // ones.
    "Enabled": false,
    // Children are listed under a GENERATED handle that discloses nothing — no real name, no
    // email, no grade, no account id. That is the only reason listing by default is defensible.
    // If handles ever become player-chosen, flip this to false before shipping the change.
    "ListedByDefault": true,
    "ProjectionBatchSize": 500,
    // A worker killed by an app-pool recycle cannot release its claim, so the lease expires
    // instead of the job sticking forever.
    "JobClaimSeconds": 300,
    "JobMaxAttempts": 5,
    "RequestLogRetentionHours": 720,
    "DefaultPageSize": 25,
    "MaxPageSize": 100,
    // Shared secret for the external pinger that drives deferred work, since shared IIS cannot be
    // trusted to keep a background loop alive. EMPTY CLOSES THE ENDPOINT — it never degrades into
    // an unauthenticated write surface. Set this in the deployment's own configuration, not here.
    "MaintenanceKey": ""
  },
  "ContentSeed": {
    // Writes the platform catalogues, the curriculum tree and its question sets. OFF by default:
    // everything it writes is an operator's content decision, and a deployment that has grown its
    // own content must never have this appear underneath it.
    "Enabled": false,
    // Run it during application start. Leave false in a deployment and call POST /api/admin/seed
    // instead — six figures of inserts do not belong on the path to the first request.
    "RunOnStartup": false,
    "Platform": true,
    "Curriculum": true,
    // Real Identity accounts sharing one known password. Never turn this on where the database is
    // reachable from outside a development machine.
    "DemoPlayers": false,
    "ChaptersPerSubject": 3,
    "LessonsPerChapter": 5,
    "QuestionsPerLesson": 5,
    "RecoveryQuestionsPerLesson": 3,
    "DemoPlayerCount": 24,
    "BatchSize": 4000
  },
  "Equipment": {
    // Reject a save that equips a cosmetic the account has no entitlement for.
    // OFF until every default/starter cosmetic is granted as a real entitlement — otherwise
    // players wearing a default they never "bought" are refused and cannot save at all.
    "EnforceOwnership": false
  },
  "Multiplayer": {
    // Four writes a minute per live session, and only from the host.
    "HeartbeatIntervalSeconds": 15,
    // Four missed heartbeats. Sized to survive a lift, a tunnel, and a Wi-Fi/cellular handover —
    // all ordinary on a phone, none of which should kill a match in progress.
    "SessionTimeoutSeconds": 60,
    // A session stuck this long in Creating never had a Photon room; it is failed and its room
    // name released.
    "CreatingTimeoutSeconds": 30,
    "PlayerDisconnectGraceSeconds": 45,
    "HostClaimGraceSeconds": 30,
    "MatchmakingCandidateLimit": 10,
    "RequestLogRetentionHours": 24,
    "SweepIntervalSeconds": 30,
    // Realtime contract versions this server will seat. A LIST so that a staged rollout can accept
    // two client builds at once — widening it is an ops change, not a deploy. Bump only when the
    // networked contract changes incompatibly; this is not the app version.
    "AcceptedProtocolVersions": [ 1 ]
  },
  "RateLimiting": {
    // Master switch. Drop to false to shed every limit below without a rebuild.
    "Enabled": true,
    // Backstop across all endpoints, per user (per address when anonymous). Sized well above the
    // client's launch burst — a global limit that trips during normal play is worse than none.
    "GlobalPermitsPerMinute": 240,
    // Per address, on the anonymous credential routes only. This is the password-spraying budget:
    // no human logs in twenty times a minute, and a credential-stuffer needs thousands.
    "AuthPermitsPerMinute": 20,
    // Per user, on the state-changing routes — attempts, purchases, grants, session creation.
    // Generous against real play; tight enough that replaying a captured request goes nowhere.
    "WritePermitsPerMinute": 60,
    // Per user, on telemetry ingest only. Higher than the write budget on purpose: a device that
    // has been offline drains its queue on reconnect, and throttling that to the write limit would
    // mean a week's backlog expires against the backlog window before it lands.
    "TelemetryPermitsPerMinute": 120,
    // Read the client address from X-Forwarded-For instead of the socket. LEAVE FALSE unless a
    // proxy that overwrites that header sits in front of the app: trusting it otherwise lets a
    // caller forge a fresh address per request and walk through every per-address limit here.
    // IIS in-process hosting (the current deployment) passes the real address through already.
    "TrustForwardedForHeader": false
  },
  "Telemetry": {
    // Master switch. When false, ingest sheds with a retry-after instead of refusing — the client
    // keeps its queue rather than dropping events the pipeline was only temporarily not taking.
    "Enabled": true,
    // Events per request. Returned in every response, so lowering it takes effect on the client's
    // next batch rather than at its next release.
    "MaxBatchSize": 100,
    // How far a client may backdate an event. Older is clamped forward, never refused — a tablet
    // offline for a fortnight has real events on it, and a wrong device clock must not be able to
    // drop them into a cohort they do not belong to.
    "MaxBacklogDays": 14,
    // THE IDENTITY-GAP GUARD. Sequence is an identity column, so 100 can commit while 99 is still
    // in flight; a projector that watermarked at MAX(Sequence) would skip 99 permanently. This must
    // exceed the longest possible ingest transaction, and ingest is a single insert.
    "SafetyLagSeconds": 30,
    "ProjectionBatchSize": 2000,
    "MaxProjectionPassesPerTick": 20,
    "ProjectionIntervalSeconds": 20,
    // Cohort rebuild and unique-user recompute. Twelve rather than twenty-four so a missed run
    // costs half a day of freshness on tables that are cheap to redo.
    "NightlyIntervalHours": 12,
    // Furthest day index the retention triangle is computed to. Covers D1/D7/D30 with room; going
    // to 365 multiplies the cells by four for a question almost nobody asks of a live game.
    "MaxCohortDayIndex": 90,
    // How far back the nightly pass recomputes. A late batch can add activity to a day already
    // summarised, so the recent window is always redone rather than trusted.
    "NightlyLookbackDays": 35,
    // RAW EVENTS ONLY. Rollups are never swept — they are what keeps a ten-year-old cohort
    // answerable after its events are long gone. Per-event overrides live in the registry.
    "BehaviouralRetentionDays": 90,
    "OperationalRetentionDays": 30,
    "RetentionBatchSize": 5000,
    "MaxRetentionPassesPerTick": 20,
    "RetentionIntervalMinutes": 60,
    "MaxTimelinePageSize": 200,
    // Widest range an admin query may cover. At scale a three-year range typed by accident is an
    // outage rather than a slow page.
    "MaxQueryRangeDays": 400
  },
  "Authentication": {
    "Google": {
      "ClientId": "1010760292778-hr6egsb6vsdpqq4dflud5ianro298ank.apps.googleusercontent.com"
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    }
  }
}
