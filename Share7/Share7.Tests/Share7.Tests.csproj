<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Share7.Infrastructure\Share7.Infrastructure.csproj" />

    <!-- Build order only. The contract tests run the API as its own process (Contracts/ContractHost),
         so they need it built next to this project's output, not loaded into it. -->
    <ProjectReference Include="..\Share7\Share7.API.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- A mismatch writes the actual output beside its baseline for diffing. Never a baseline. -->
    <None Remove="Contracts\Snapshots\*.received.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
